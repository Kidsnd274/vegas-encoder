#include <winver.h>
#include "../../version.generated.h"

#if defined(VEGAS_ENCODER_B6_RECIPE_PROOF)
#define VE_FILE_VERSION VE_APP_FILE_VERSION
#define VE_PRODUCT_VERSION VE_EXPORTER_VERSION
#elif defined(VEGAS_ENCODER_PROGRESS_TEXT_PROOF)
#define VE_FILE_VERSION VE_LEGACY_PROGRESS_TEXT_FILE_VERSION
#define VE_PRODUCT_VERSION VE_LEGACY_PROGRESS_TEXT_VERSION
#elif defined(VEGAS_ENCODER_CONFIGURATION_PROOF)
#define VE_FILE_VERSION VE_LEGACY_CONFIGURATION_FILE_VERSION
#define VE_PRODUCT_VERSION VE_LEGACY_CONFIGURATION_VERSION
#else
#define VE_FILE_VERSION VE_LEGACY_DEFAULT_FILE_VERSION
#define VE_PRODUCT_VERSION VE_LEGACY_DEFAULT_VERSION
#endif

1 VERSIONINFO
 FILEVERSION VE_FILE_VERSION
 PRODUCTVERSION VE_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Vegas Encoder VEGAS exporter\0"
      VALUE "FileVersion", VE_PRODUCT_VERSION "\0"
      VALUE "ProductName", "Vegas Encoder\0"
      VALUE "ProductVersion", VE_PRODUCT_VERSION "\0"
      VALUE "OriginalFilename", "vegas-encoder.dll\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
