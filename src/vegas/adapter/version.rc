#include <winver.h>

#if defined(VEGAS_ENCODER_B6_RECIPE_PROOF)
#define VE_FILE_VERSION 0,1,7,1
#define VE_PRODUCT_VERSION "0.1.7-recipe-proof"
#elif defined(VEGAS_ENCODER_PROGRESS_TEXT_PROOF)
#define VE_FILE_VERSION 0,1,3,0
#define VE_PRODUCT_VERSION "0.1.3-progress-text-proof"
#elif defined(VEGAS_ENCODER_CONFIGURATION_PROOF)
#define VE_FILE_VERSION 0,1,2,0
#define VE_PRODUCT_VERSION "0.1.2-config-proof"
#else
#define VE_FILE_VERSION 0,1,1,0
#define VE_PRODUCT_VERSION "0.1.1-dev"
#endif

1 VERSIONINFO
 FILEVERSION VE_FILE_VERSION
 PRODUCTVERSION VE_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Vegas Encoder VEGAS exporter\0"
      VALUE "FileVersion", VE_PRODUCT_VERSION "\0"
      VALUE "ProductName", "Vegas Encoder\0"
      VALUE "ProductVersion", VE_PRODUCT_VERSION "\0"
      VALUE "OriginalFilename", "vegas-encoder.dll\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
